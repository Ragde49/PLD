<%@ Master Language="VB" AutoEventWireup="true" CodeBehind="Site.master.vb" Inherits="PLD.SiteMaster" %>

<!DOCTYPE html>
<html lang="es" data-layout-mode="default">
<head runat="server">
    <meta charset="utf-8" />
    <title>Sistema PLD</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- App favicon (TechUI) -->
    <link rel="shortcut icon" href="/assets/images/favicon.ico" />

    <!-- TechUI Theme Config -->
    <script src="/assets/js/config.js"></script>

    <!-- Font Family (TechUI) -->
    <link href="https://api.fontshare.com/v2/css?f[]=satoshi@900,700,500,300,400&display=swap" rel="stylesheet" />

    <!-- Bootstrap (Base) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <!-- TechUI App CSS -->
    <link href="/assets/css/app.min.css" rel="stylesheet" type="text/css" />

    <!-- Material Design Icons (TechUI menu arrows) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/MaterialDesign-Webfont/7.4.47/css/materialdesignicons.min.css" />


    <!-- Font Awesome (Sistema) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free/css/all.min.css" />

    <!-- SweetAlert2 -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.7.12/dist/sweetalert2.min.css" />

    <!-- DataTables (Bootstrap 5) -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <style>
        :root {
            --tz-logo-lg-height: 46px;
            --tz-footer-height: 78px;
        }

        /* Ajuste mínimo para que el breadcrumb del Master se vea como el estilo TechUI */
        #pld-page-title {
            padding-top: .5rem;
            padding-bottom: .5rem;
        }

        /* Evitar que el breadcrumb literal traiga márgenes raros */
        #pld-breadcrumb nav,
        #pld-breadcrumb ol {
            margin-bottom: 0 !important;
        }

        /* El breadcrumb literal de PLD trae su propia estructura; lo hacemos compact */
        #pld-breadcrumb .breadcrumb {
            font-size: .85rem;
        }

        .app-sidenav .logo-box .logo-lg {
            width: auto;
            max-width: 180px;
            object-fit: contain;
        }

        .footer-softcame {
            border-top: 1px solid #d8e8dc;
            background: linear-gradient(90deg, #ffffff 0%, #f4fbf6 48%, #eaf7ee 100%);
            color: #101513;
        }

        .footer-softcame a {
            color: #0b8f43;
            font-weight: 700;
        }

        .footer-softcame a:hover {
            color: #066d31;
        }

        .heartbeat-heart {
            display: inline-block;
            color: #11a34c;
            transform-origin: center;
            animation: heartbeat-softcame 1.8s ease-in-out infinite;
        }

        @keyframes heartbeat-softcame {
            0%, 100% { transform: scale(1); }
            14% { transform: scale(1.12); }
            28% { transform: scale(1); }
            42% { transform: scale(1.16); }
            56% { transform: scale(1); }
        }

        @media (max-width: 767.98px) {
            :root {
                --tz-logo-lg-height: 42px;
                --tz-footer-height: 96px;
            }

            .footer-softcame {
                padding-top: .75rem;
                padding-bottom: .75rem;
            }
        }
    </style>
</head>
<body>

<form id="form1" runat="server">

    <!-- Begin page -->
    <div class="app-wrapper">

        <!-- SIDENAV (TechUI) -->
        <div class="app-sidenav">

            <!-- Brand Logo -->
            <div class="logo-box">
                <a href="../default.aspx" class="logo-light">
                    <img src="/assets/images/logo-light.png" alt="logo" class="logo-lg" />
                    <img src="/assets/images/logo-sm.png" alt="small logo" class="logo-sm" />
                </a>

                <a href="../default.aspx" class="logo-dark">
                    <img src="/assets/images/logo-dark.png" alt="dark logo" class="logo-lg" />
                    <img src="/assets/images/logo-sm.png" alt="small logo" class="logo-sm" />
                </a>
            </div>

            <!-- Menu -->
            <div class="h-100" data-simplebar>
                <asp:Literal ID="litMenu" runat="server" />
                <div class="clearfix"></div>
            </div>

        </div>
        <!-- SIDENAV END -->

        <!-- ============================================================== -->
        <!-- Start Page Content here -->
        <!-- ============================================================== -->

        <div class="content-page">

            <!-- TOPBAR (TechUI) -->
            <div class="navbar-custom">
                <div class="topbar px-2">
                    <div class="topbar-menu d-flex align-items-center gap-lg-2 gap-1">

                        <!-- Sidebar Toggle -->
                        <button type="button" class="button-toggle-menu" aria-label="Toggle menu">
                            <i data-feather="menu"></i>
                        </button>

                        <div class="d-none d-md-flex align-items-center ms-2">
                            <span class="fw-semibold">Bienvenido al Sistema PLD</span>
                            <span class="ms-2 badge bg-light text-dark" title="Versión del sistema">
                                v<asp:Literal ID="litAppVersion" runat="server" />
                            </span>
                        </div>
                    </div>
                    <ul class="topbar-menu d-flex align-items-center gap-3">
                        <li class="d-flex align-items-center gap-2">
                            <asp:Literal ID="litCurrentUser" runat="server" />
                        </li>
                    </ul>
                </div>
            </div>
            <!-- TOPBAR END -->

            <div class="content">

                <!-- Start Content-->
                <div class="container-fluid">

                    <!-- Page Title + Breadcrumb (PLD) -->
                    <div class="row" id="pld-page-title">
                        <div class="col-12">
                            <div class="d-flex justify-content-between align-items-center">
<%--                                <h4 class="mb-0"><%: Page.Title %></h4>--%>
                                <div id="pld-breadcrumb" class="d-lg-flex d-none">
                                    <asp:Literal ID="LiteralBreadcrumb" runat="server" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Main Content -->
                    <asp:ContentPlaceHolder ID="MainContent" runat="server" />

                </div>
                <!-- container-fluid -->

            </div>
            <!-- content -->

            <div class="footer footer-softcame">
                <div class="container-fluid px-0">
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-2 w-100">
                        <div class="small fw-semibold">© <%= System.DateTime.Now.Year %> SOFTCAME</div>
                        <div class="small text-center text-md-end">
                            Desarrollado con amor <span class="heartbeat-heart" aria-hidden="true">&#10084;</span> by
                            <a href="https://softcame.com" target="_blank" rel="noopener noreferrer">SOFTCAME</a>
                        </div>
                    </div>
                </div>
            </div>

        </div>
        <!-- content-page -->

    </div>
    <!-- app-wrapper -->

</form>

<!-- jQuery (primero) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<!-- Bootstrap Bundle (incluye Popper) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<!-- DataTables core JS -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<!-- DataTables Bootstrap 5 integration -->
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<!-- Moment.js -->
<script src="https://cdn.jsdelivr.net/npm/moment@2.29.4/moment.min.js"></script>

<!-- TechUI dependencies -->
<script src="/assets/js/simplebar.min.js"></script>
<script src="/assets/js/feather.min.js"></script>
<script src="/assets/js/app.min.js"></script>

<script>
    // Feather icons init (seguro aunque no existan algunos)
    document.addEventListener('DOMContentLoaded', function () {
        try {
            if (window.feather && typeof window.feather.replace === 'function') {
                window.feather.replace();
            }
        } catch (e) { }
    });
</script>

</body>
</html>
